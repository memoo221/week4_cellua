# Copy to .env and fill in. Never commit the real .env.

# --- services/memory.py ---
MEMORY_DB_PATH=data/memory.db

# --- services/llm.py (OpenRouter) ---
# Get a key at https://openrouter.ai/keys — listing models (list_free_models)
# works without one; chat completions require it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-task model overrides. Default to a free OpenRouter model if unset —
# see services/llm.py:list_free_models() for what's currently available.
CLASSIFIER_MODEL=
